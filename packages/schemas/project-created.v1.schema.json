      "projectId": "0193f1a2-7c4e-7b1a-9f00-1234567890ab",
      "status": "ready"
    }
  ],
  "properties": {
    "projectId": {
      "title": "Projectid",
      "type": "string"
    },
    "jobId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
