{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "music-world.project-created.v1",
  "$comment": "GENERATED — do not edit. Source: apps/api/music_world/schemas (run `make schemas`).",
  "additionalProperties": false,
