{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "music-world.layout-result.v1",
  "$comment": "GENERATED — do not edit. Source: apps/api/music_world/schemas (run `make schemas`).",
  "$defs": {
    "FallbackStep": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "muse",
            "bedrock",
            "mock"
          ],
          "title": "Provider",
          "type": "string"
        },
        "reason": {
          "enum": [
            "NOT_CONFIGURED",
            "SPEND_CAP",
            "TIMEOUT",
            "HTTP_ERROR",
            "RATE_LIMITED",
            "REFUSED",
            "INVALID_JSON",
            "INVALID_OUTPUT"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "reason"
      ],
      "title": "FallbackStep",
      "type": "object"
    },
    "InventoryEntry": {
      "additionalProperties": false,
      "description": "One kind of object the template can put in the world, with its role (what it is for).",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "enum": [
                "terrain_ridge",
                "building",
                "spike",
                "crystal",
                "cluster",
                "cloud",
                "tree",
                "conifer",
                "bush",
                "car",
                "bicycle",
                "airplane"
              ],
              "type": "string"
            },
            {
              "pattern": "^recipe:[a-z0-9_]{1,40}$",
              "type": "string"
            }
          ],
          "title": "Kind"
        },
        "role": {
          "enum": [
            "building",
            "flora",
            "vehicle",
            "sky",
            "landmark",
            "terrain",
            "benthic",
            "swimmer",
            "giant",
            "effect",
            "other"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "role"
      ],
      "title": "InventoryEntry",
      "type": "object"
    },
    "LayoutPatch": {
      "additionalProperties": false,
      "description": "A region of the plate (normalized -1..1) where objects of one theme grow, from the centre of the world out.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]{1,24}$",
          "title": "Id",
          "type": "string"
        },
        "theme": {
          "enum": [
            "kelp",
            "coral",
            "sand",
            "wreck",
            "keep",
            "village",
            "forest",
            "crystal"
          ],
          "title": "Theme",
          "type": "string"
        },
        "x": {
          "maximum": 1,
          "minimum": -1,
          "title": "X",
          "type": "number"
        },
        "z": {
          "maximum": 1,
          "minimum": -1,
          "title": "Z",
          "type": "number"
        },
        "radius": {
          "description": "Fraction of the half plate.",
          "maximum": 0.6,
          "minimum": 0.05,
          "title": "Radius",
          "type": "number"
        }
      },
      "required": [
        "id",
        "theme",
        "x",
        "z",
        "radius"
      ],
      "title": "LayoutPatch",
      "type": "object"
    },
    "LayoutStep": {
      "additionalProperties": false,
      "description": "One object of the inventory, the patch it grows in and how often the notes pick it.",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "enum": [
                "terrain_ridge",
                "building",
                "spike",
                "crystal",
                "cluster",
                "cloud",
                "tree",
                "conifer",
                "bush",
                "car",
                "bicycle",
                "airplane"
              ],
              "type": "string"
            },
            {
              "pattern": "^recipe:[a-z0-9_]{1,40}$",
              "type": "string"
            }
          ],
          "title": "Kind"
        },
        "patch": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]{1,24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of a layout patch; none for objects the street plan of a city places.",
          "title": "Patch"
        },
        "weight": {
          "default": 1.0,
          "description": "0 keeps the object out of the note rotation.",
          "maximum": 10,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LayoutStep",
      "type": "object"
    },
    "PlacedObject": {
      "additionalProperties": false,
      "description": "An object a creator put on the map by hand (map creator): it stands from the first frame, fully grown.\n\n`x`, `z` are metres from the centre of the plate (the world of a city or a reef is wider than the plate), `yaw`\ndegrees about the vertical axis, `scale` multiplies the height of the kind. Notes still spawn their own objects.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]{1,24}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "terrain_ridge",
                "building",
                "spike",
                "crystal",
                "cluster",
                "cloud",
                "tree",
                "conifer",
                "bush",
                "car",
                "bicycle",
                "airplane"
              ],
              "type": "string"
            },
            {
              "pattern": "^recipe:[a-z0-9_]{1,40}$",
              "type": "string"
            }
          ],
          "title": "Kind"
        },
        "x": {
          "default": 0,
          "maximum": 64,
          "minimum": -64,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "maximum": 20,
          "minimum": -2,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "default": 0,
          "maximum": 64,
          "minimum": -64,
          "title": "Z",
          "type": "number"
        },
        "yaw": {
          "default": 0,
          "maximum": 180,
          "minimum": -180,
          "title": "Yaw",
          "type": "number"
        },
        "scale": {
          "default": 1,
          "maximum": 5,
          "minimum": 0.2,
          "title": "Scale",
          "type": "number"
        },
        "variant": {
          "default": 0,
          "description": "Look variant (building type, tree shape).",
          "maximum": 15,
          "minimum": 0,
          "title": "Variant",
          "type": "integer"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override of the colour of this object.",
          "title": "Color"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "PlacedObject",
      "type": "object"
    },
    "WorldLayout": {
      "additionalProperties": false,
      "description": "How the objects of a template are laid out: written by the director from the template's inventory.\n\nNotes walk through `sequence` in order (each step in proportion to its weight): the note gets that object and a\nspot inside that patch. A template without a layout gets one derived from its inventory (web engine).",
      "properties": {
        "inventory": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InventoryEntry"
          },
          "maxItems": 40,
          "title": "Inventory",
          "type": "array"
        },
        "patches": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LayoutPatch"
          },
          "maxItems": 24,
          "title": "Patches",
          "type": "array"
        },
        "sequence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LayoutStep"
          },
          "maxItems": 48,
          "title": "Sequence",
          "type": "array"
        },
        "placed": {
          "default": [],
          "description": "Objects placed by hand on a user map.",
          "items": {
            "$ref": "#/$defs/PlacedObject"
          },
          "maxItems": 400,
          "title": "Placed",
          "type": "array"
        },
        "seed": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "World seed chosen by the creator of a map; none: random.",
          "title": "Seed"
        }
      },
      "title": "WorldLayout",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The object layout the director wrote for a chosen template, and which provider wrote it.",
  "properties": {
    "layout": {
      "$ref": "#/$defs/WorldLayout"
    },
    "provider": {
      "enum": [
        "muse",
        "bedrock",
        "mock"
      ],
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "requestedProvider": {
      "enum": [
        "muse",
        "bedrock",
        "mock"
      ],
      "title": "Requestedprovider",
      "type": "string"
    },
    "fallbacks": {
      "items": {
        "$ref": "#/$defs/FallbackStep"
      },
      "title": "Fallbacks",
      "type": "array"
    }
  },
  "required": [
    "layout",
    "provider",
    "model",
    "requestedProvider"
  ],
  "title": "LayoutResult",
  "type": "object"
}
