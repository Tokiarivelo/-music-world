{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "music-world.shape.v1",
  "$comment": "GENERATED — do not edit. Source: apps/api/music_world/schemas (run `make schemas`).",
  "$defs": {
    "Part": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "box",
            "prism",
            "spike",
            "stack",
            "cluster"
          ],
          "title": "Op",
          "type": "string"
        },
        "of": {
          "default": "box",
          "description": "stack and cluster: the primitive that is repeated.",
          "enum": [
            "box",
            "prism",
            "spike"
          ],
          "title": "Of",
          "type": "string"
        },
        "width": {
          "default": 0.5,
          "description": "Footprint along x (diameter for prism and spike).",
          "maximum": 1,
          "minimum": 0.05,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "default": 0.5,
          "description": "Footprint along z (box only).",
          "maximum": 1,
          "minimum": 0.05,
          "title": "Depth",
          "type": "number"
        },
        "height": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0.05,
          "title": "Height",
          "type": "number"
        },
        "y": {
          "default": 0,
          "description": "Height of the part's base above the shape's base.",
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "sides": {
          "default": 6,
          "description": "prism, and a repeated prism: number of sides.",
          "maximum": 12,
          "minimum": 3,
          "title": "Sides",
          "type": "integer"
        },
        "taper": {
          "default": 1,
          "description": "prism: top radius / bottom radius; 0 ends in a point.",
          "maximum": 1,
          "minimum": 0,
          "title": "Taper",
          "type": "number"
        },
        "levels": {
          "default": 3,
          "description": "stack: number of floors.",
          "maximum": 8,
          "minimum": 2,
          "title": "Levels",
          "type": "integer"
        },
        "shrink": {
          "default": 0.8,
          "description": "stack: width of a floor / width of the one below.",
          "maximum": 1,
          "minimum": 0.5,
          "title": "Shrink",
          "type": "number"
        },
        "count": {
          "default": 4,
          "description": "cluster: number of copies.",
          "maximum": 12,
          "minimum": 2,
          "title": "Count",
          "type": "integer"
        },
        "spread": {
          "default": 0.6,
          "description": "cluster: radius of the ring of copies (unit square).",
          "maximum": 1,
          "minimum": 0,
          "title": "Spread",
          "type": "number"
        },
        "seedOffset": {
          "default": 0,
          "description": "cluster: varies the heights and angles.",
          "maximum": 99,
          "minimum": 0,
          "title": "Seedoffset",
          "type": "integer"
        }
      },
      "required": [
        "op"
      ],
      "title": "Part",
      "type": "object"
    },
    "PartMaterial": {
      "additionalProperties": false,
      "description": "Look of one part. A colour tints the object's own colour (white keeps it); it never replaces it.",
      "properties": {
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hex tint of the part. Wins over `color_role`.",
          "title": "Color"
        },
        "colorRole": {
          "anyOf": [
            {
              "enum": [
                "primary",
                "accent",
                "secondary",
                "staff",
                "line"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tint taken from the template palette.",
          "title": "Colorrole"
        },
        "emissive": {
          "default": 0,
          "description": "Glow: 0 none, 1 about 60 % brighter.",
          "maximum": 1,
          "minimum": 0,
          "title": "Emissive",
          "type": "number"
        },
        "roughness": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0 mirror-like, 1 matte (lit material only).",
          "title": "Roughness"
        },
        "texture": {
          "default": "none",
          "description": "Procedural pattern drawn by the shader (no image file).",
          "enum": [
            "none",
            "brick",
            "wood",
            "stone",
            "tile",
            "glass"
          ],
          "title": "Texture",
          "type": "string"
        }
      },
      "title": "PartMaterial",
      "type": "object"
    },
    "PartNode": {
      "additionalProperties": false,
      "description": "A named part of an object, edited like a Blender outliner entry.\n\nNodes are a flat list; `parent` names an earlier node. A child's position and rotation are in its parent's local\nspace (the parent's size is not inherited). `position` is the centre of the node's base: y = 0 stands it on the\nobject's base (or on its parent's origin).",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]{1,24}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "primitive": {
          "default": "box",
          "enum": [
            "box",
            "cylinder",
            "cone",
            "sphere",
            "prism",
            "gable"
          ],
          "title": "Primitive",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]{1,24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "hidden": {
          "default": false,
          "title": "Hidden",
          "type": "boolean"
        },
        "position": {
          "$ref": "#/$defs/Vec3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "rotation": {
          "$ref": "#/$defs/Rotation",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        "size": {
          "$ref": "#/$defs/Size",
          "default": {
            "x": 0.5,
            "y": 0.5,
            "z": 0.5
          }
        },
        "sides": {
          "default": 8,
          "description": "cylinder, cone, prism: number of sides.",
          "maximum": 12,
          "minimum": 3,
          "title": "Sides",
          "type": "integer"
        },
        "taper": {
          "default": 1,
          "description": "prism: top radius / bottom radius; 0 ends in a point.",
          "maximum": 1,
          "minimum": 0,
          "title": "Taper",
          "type": "number"
        },
        "material": {
          "$ref": "#/$defs/PartMaterial",
          "default": {
            "color": null,
            "colorRole": null,
            "emissive": 0.0,
            "roughness": null,
            "texture": "none"
          }
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "PartNode",
      "type": "object"
    },
    "Rotation": {
      "additionalProperties": false,
      "description": "Euler angles in degrees, applied in the order y, x, z.",
      "properties": {
        "x": {
          "default": 0,
          "maximum": 180,
          "minimum": -180,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "maximum": 180,
          "minimum": -180,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "default": 0,
          "maximum": 180,
          "minimum": -180,
          "title": "Z",
          "type": "number"
        }
      },
      "title": "Rotation",
      "type": "object"
    },
    "ShapeBudget": {
      "additionalProperties": false,
      "properties": {
        "maxTriangles": {
          "default": 500,
          "description": "Upper bound of the built geometry; the recipe is rejected when its parts need more.",
          "maximum": 2000,
          "minimum": 12,
          "title": "Maxtriangles",
          "type": "integer"
        }
      },
      "title": "ShapeBudget",
      "type": "object"
    },
    "Size": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0.5,
          "description": "Width.",
          "maximum": 2,
          "minimum": 0.02,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.5,
          "description": "Height.",
          "maximum": 2,
          "minimum": 0.02,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "default": 0.5,
          "description": "Depth.",
          "maximum": 2,
          "minimum": 0.02,
          "title": "Z",
          "type": "number"
        }
      },
      "title": "Size",
      "type": "object"
    },
    "Vec3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0,
          "maximum": 2,
          "minimum": -2,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "maximum": 2,
          "minimum": -2,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "default": 0,
          "maximum": 2,
          "minimum": -2,
          "title": "Z",
          "type": "number"
        }
      },
      "title": "Vec3",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Parts of a shape from a closed list of operations, with its own triangle budget.",
  "properties": {
    "schema": {
      "const": "music-world.shape.v1",
      "default": "music-world.shape.v1",
      "title": "Schema",
      "type": "string"
    },
    "name": {
      "description": "Referenced by templates as the kind `recipe:<name>`.",
      "pattern": "^[a-z0-9_]{1,40}$",
      "title": "Name",
      "type": "string"
    },
    "parts": {
      "default": [],
      "description": "Legacy operations; `nodes` is the editable form.",
      "items": {
        "$ref": "#/$defs/Part"
      },
      "maxItems": 8,
      "title": "Parts",
      "type": "array"
    },
    "nodes": {
      "default": [],
      "description": "Part tree (flat, parents first). Built after `parts`.",
      "items": {
        "$ref": "#/$defs/PartNode"
      },
      "maxItems": 48,
      "title": "Nodes",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/ShapeBudget",
      "default": {
        "maxTriangles": 500
      }
    },
    "footprint": {
      "default": 0.25,
      "description": "Side of the unit footprint in metres on the plate: wide shapes (a whale, a wreck) use more.",
      "maximum": 1.5,
      "minimum": 0.1,
      "title": "Footprint",
      "type": "number"
    },
    "heightScale": {
      "default": 1,
      "description": "Multiplies the instance height (0.5 to 1.5 m by default): below 1 makes a squat shape.",
      "maximum": 2,
      "minimum": 0.1,
      "title": "Heightscale",
      "type": "number"
    }
  },
  "required": [
    "name"
  ],
  "title": "ShapeRecipe",
  "type": "object"
}
