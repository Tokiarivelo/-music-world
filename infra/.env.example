# Copy to infra/.env on the server (never commit infra/.env). Local `make dev` works without it.
# Check it before every deploy: infra/scripts/check-env.sh (also run by infra/deploy.sh). Values are never printed.

# Public domain served by Caddy (localhost = Caddy's local CA). Production: a DNS A/AAAA record pointing to the
# instance, ports 80 and 443 open (Let's Encrypt HTTP-01 challenge).
DOMAIN=localhost
APP_ENV=production
LOG_LEVEL=INFO
API_DOCS=false

POSTGRES_USER=music_world
# At least 16 characters: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=music_world

# OVHcloud Object Storage (S3 API). Empty → /api/health reports storage "not_configured".
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Local object store used while the S3_* settings above are incomplete (inside the containers).
STORAGE_DIR=/data/storage

# Analysis worker.
ANALYSIS_MIN_VELOCITY=0.25
DEMUCS_MODEL=htdemucs
LYRICS_PROVIDER=muse

# AI World Director (05-ai-world-director). Without any key the deterministic mock director is used.
# LLM_PROVIDER = default provider: muse | bedrock | mock (the play page can pick another configured one).
LLM_PROVIDER=muse
# Meta Model API (Muse). Server only. The default director model is the cheaper `-contributor` id: Meta may train on the
# inputs (a text summary of the song and its lyrics). The upload page tells users. Use `muse-spark-1.3` to opt out.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_DIRECTOR_MODEL=muse-spark-1.3-contributor
META_SHAPE_MODEL=muse-wonder-1.0
# Lyrics transcription from the vocal stem (LYRICS_PROVIDER=muse).
META_VOICE_MODEL=muse-voice-transcribe-1.0
# Estimated USD per analysis (both real providers); over it the mock director is used.
META_SPEND_CAP_USD=1
# Claude in Amazon Bedrock (bedrock-mantle). Region + credentials (keys, profile or a Bedrock API key).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only with temporary (STS) credentials.
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-5
BEDROCK_SHAPE_MODEL_ID=anthropic.claude-opus-5-5
DIRECTOR_TIMEOUT_SEC=30
DIRECTOR_AUDIO_HINT=false
DIRECTOR_RATE_LIMIT_PER_HOUR=30

# Accounts and template store (06-template-store). Sign-in by e-mail magic link.
# Origin of the web app: sign-in links point to $PUBLIC_BASE_URL/auth/verify (Compose default: https://$DOMAIN).
PUBLIC_BASE_URL=
# console = the link is written to the api logs (development only); smtp = real e-mail with the SMTP_* settings.
AUTH_EMAIL_SENDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
AUTH_TOKEN_TTL_MIN=15
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=true
AUTH_RATE_LIMIT_PER_HOUR=10
TEMPLATE_PUBLISH_RATE_LIMIT_PER_HOUR=10
TEMPLATE_REPORT_HIDE_THRESHOLD=3
UPLOAD_RATE_LIMIT_PER_HOUR=20
