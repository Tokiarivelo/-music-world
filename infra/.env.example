# Copy to infra/.env on the server (never commit infra/.env). Local `make dev` works without it.

# Public domain served by Caddy (localhost = Caddy's local CA).
DOMAIN=localhost
APP_ENV=production
LOG_LEVEL=INFO
API_DOCS=false

POSTGRES_USER=music_world
POSTGRES_PASSWORD=change-me
POSTGRES_DB=music_world

# OVHcloud Object Storage (S3 API). Empty → /api/health reports storage "not_configured".
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Local object store used while the S3_* settings above are incomplete (inside the containers).
STORAGE_DIR=/data/storage

# Analysis worker.
ANALYSIS_MIN_VELOCITY=0.25
DEMUCS_MODEL=htdemucs
LYRICS_PROVIDER=muse
