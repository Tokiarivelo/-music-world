# DOMAIN=localhost → Caddy's internal CA (local); a real domain → Let's Encrypt.
{$DOMAIN:localhost} {
	encode zstd gzip

	# FastAPI already hides docs outside development; Caddy blocks them too unless API_DOCS=true.
	@docs {
		path /api/docs* /api/openapi.json
		expression `{env.API_DOCS} != "true"`
	}
	handle @docs {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
