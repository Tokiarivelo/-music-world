  "palette": {
    "background": "#07051a",
    "terrain": "#1a1533",
    "primary": "#b04cff",
    "accent": "#ff4fd8",
    "secondary": "#22d3ee",
    "staff": "#e8f7ff"
  },
  "terrain": { "style": "cracked_plate", "mountains": "edges", "size": 12 },
  "staff": {
    "style": "glowing_lines",
    "path": "diagonal_curve",
    "clef": "treble",
    "glow": 1.2,
    "lookahead": 4.0,
    "fallDuration": 0.35
  },
  "mappings": [
    { "when": { "pitch": "<48" }, "spawn": "terrain_ridge", "heightFrom": "velocity" },
    { "when": { "pitch": "48-72" }, "spawn": "building", "heightFrom": "velocity" },
    { "when": { "pitch": "73-84" }, "spawn": "spike", "heightFrom": "velocity" },
