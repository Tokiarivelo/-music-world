  "zones": [
    { "kind": "building", "xMin": -0.95, "xMax": 0.0, "zMin": -0.95, "zMax": -0.4 },
    { "kind": "building", "xMin": -0.95, "xMax": -0.22, "zMin": -0.4, "zMax": 0.2 },
    { "kind": "building", "xMin": -0.95, "xMax": -0.5, "zMin": 0.2, "zMax": 0.8 },
    { "kind": "spike", "xMin": -0.95, "xMax": -0.05, "zMin": -0.95, "zMax": -0.65 },
    { "kind": "spike", "xMin": -0.95, "xMax": -0.72, "zMin": -0.65, "zMax": 0.45 },
    { "kind": "terrain_ridge", "xMin": 0.72, "xMax": 0.95, "zMin": -0.6, "zMax": 0.95 },
    { "kind": "terrain_ridge", "xMin": -0.1, "xMax": 0.72, "zMin": 0.78, "zMax": 0.95 }
  ],
  "budget": { "instancesPerKind": 2000 },
  "fx": { "particles": "arcs", "bloom": 0.8, "beatPulse": true, "chordLinks": "light_arc", "material": "flat" }
}
