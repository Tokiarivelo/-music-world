# Local API / worker WITHOUT Docker (make dev-api, make dev-worker). Copy to apps/api/.env (git-ignored).
# `uv run --env-file .env` loads it; the Settings class itself never reads a file (see music_world/shared/settings.py).
# Docker stack and production: use infra/.env.example instead (Compose builds DATABASE_URL and REDIS_URL itself).
# Full variable reference: .kiro/steering/tech.md. Every value below is the code default unless noted.

APP_ENV=development
LOG_LEVEL=INFO
# /api/docs is always on in development.
API_DOCS=false

# Postgres and Redis from `make dev-infra` (published on 127.0.0.1 only). Without Docker, any
# sqlite+aiosqlite:///<file> URL works for the API: DATABASE_URL=sqlite+aiosqlite:///.data/dev.db
DATABASE_URL=postgresql+asyncpg://music_world:music_world@localhost:5432/music_world
REDIS_URL=redis://localhost:6379/0

# Local object store (uploads, stems, checkpoints) while the S3_* values below are incomplete.
STORAGE_DIR=.data/storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Analysis worker.
ANALYSIS_MIN_VELOCITY=0.25
DEMUCS_MODEL=htdemucs
LYRICS_PROVIDER=muse

# AI World Director. No key = deterministic mock director. LLM_PROVIDER = muse | bedrock | mock.
LLM_PROVIDER=muse
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_DIRECTOR_MODEL=muse-spark-1.3-contributor
META_SHAPE_MODEL=muse-wonder-1.0
META_VOICE_MODEL=muse-voice-transcribe-1.0
META_SPEND_CAP_USD=1
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Alternative to keys: a named profile or a Bedrock API key.
AWS_PROFILE=
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-5
BEDROCK_SHAPE_MODEL_ID=anthropic.claude-opus-5-5
DIRECTOR_TIMEOUT_SEC=30
DIRECTOR_AUDIO_HINT=false
DIRECTOR_RATE_LIMIT_PER_HOUR=30

# Accounts. Local http origin (same port as WEB_PORT in apps/web/.env.local): sign-in links point to $PUBLIC_BASE_URL/auth/verify (printed in the api log with
# AUTH_EMAIL_SENDER=console), and the cookies must not be Secure over http.
PUBLIC_BASE_URL=http://localhost:3000
AUTH_EMAIL_SENDER=console
SESSION_COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
AUTH_TOKEN_TTL_MIN=15
SESSION_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_HOUR=10
TEMPLATE_PUBLISH_RATE_LIMIT_PER_HOUR=10
TEMPLATE_REPORT_HIDE_THRESHOLD=3
UPLOAD_RATE_LIMIT_PER_HOUR=20
